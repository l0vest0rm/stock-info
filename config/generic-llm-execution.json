{
  "version": "generic-llm-execution.v1",
  "executionTransport": "openai",
  "handlerTransports": {
    "generic_raw_model": "openai"
  },
  "taskTypeTransports": {},
  "originTaskTypeTransports": {
    "research_operating_analysis_low_dependency*": "webqa",
    "research_financial_analysis*": "webqa"
  },
  "webqa": {
    "taskdBaseUrl": "https://task.m2ai.cc",
    "taskdNamespace": "stock-info",
    "taskdTokenEnv": "STOCK_INFO_TASKD_CALLER_TOKEN",
    "taskdTaskType": "webqa.chatgpt.v1",
    "provider": "chatgpt-web",
    "platform": "stock-info",
    "pollIntervalMs": 1200,
    "taskTimeoutMs": 1200000,
    "cancelGraceMs": 30000,
    "heartbeatIntervalMs": 10000,
    "newSession": true,
    "singleTabMode": false,
    "attachments": []
  }
}
