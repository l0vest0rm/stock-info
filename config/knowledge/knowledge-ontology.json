      "production_capacity": { "informationTypes": ["fact", "guidance", "event"], "periodPolicy": "optional", "label": "产能", "description": "生产设施可达到的生产能力或规模，不是实际生产量、销量或出货量；不能把产量增长当作产能增长。" },
      "capacity_utilization": { "informationTypes": ["fact", "guidance", "forecast"], "periodPolicy": "required", "label": "产能利用率" },
      "market_share": { "informationTypes": ["fact", "forecast", "opinion"], "periodPolicy": "optional", "label": "市场份额" },
