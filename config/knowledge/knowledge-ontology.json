      "target_price": { "informationTypes": ["forecast", "opinion"], "periodPolicy": "optional", "label": "目标价" },
      "analyst_rating": { "informationTypes": ["opinion", "forecast"], "periodPolicy": "forbidden", "label": "分析师评级" },
