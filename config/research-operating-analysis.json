{
  "version": "investment-analysis.staged.v1",
  "model": "gpt-5.6-luna",
  "concurrency": 5,
  "reasoningEffort": "max",
  "maxOutputTokens": 16000,
  "webSearch": {
    "searchContextSize": "high",
    "required": true
  },
  "jobTimeoutMs": 1200000,
  "streamIdleTimeoutMs": 90000,
  "streamCheckpoint": {
    "intervalMs": 1500,
    "minChars": 800
  },
  "persistenceRecovery": {
    "retryIntervalMs": 2000,
    "maxWaitMs": 60000
  }
}
