{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Self-tests import domain modules directly with Node's TypeScript loader,
    // which resolves specifiers literally and therefore needs the `.ts` suffix.
    // Harmless here because emit is disabled; mirrors `web/tsconfig.json`.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
