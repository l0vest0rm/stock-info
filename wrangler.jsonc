{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "MARKET_DATA_PUBLIC_BASE_URL": "https://market-data.tinfo.cc",
    "LLM_DAILY_LIMIT": "300",
    "HTTP_PROXY_URL": "",
    "HTTP_PROXY_DOMAINS": "",
    "HTTP_DOMAIN_CONCURRENCY": "5",
    "HTTP_REQUEST_TIMEOUT_MS": "10000",
    "KNOWLEDGE_CONTENT_PUBLIC_BASE_URL": "https://content.tinfo.cc",
    "KNOWLEDGE_ALLOW_TEXT_SEARCH": "false",
    "XUEQIU_COOKIE": "acw_tc=2760774117856427601737589e1953ec30913f1d9ab54a6e5d5b55f22d2eb3; ssxmod_itna=1-eqUx0DgQYiqxBDfxe947K7jneQuqiFeGHDyxWKG7DuZxjKidDRDB4ylDA7heG=Q2eBOGhhrqnxGXxwDA5Dnzx7YDtoSPw5Kn2MimpqW4Wht5Ki_Y4X0KQTDrQmr_GQKlxpNvz6g5Ur8FLwDAEo0DGmD0=DAueD7T56DYAEDBYD74G_DDeDiobDGMuK=xDFnCRdyWiTWC_KceDEQx2NQxDgUPD1t=nrcWiKQPGfiWpN=xqDbu_m=gq=x0fkaoODzqrDbxo3LU8Dtuye27ItxaWT0FetQk1rn3I5eOUxBDvKQGqsWvGM7DhcwDqWvx0h5F04CH4c_FDDW3QhQ7DlieCMkhqrwTe2MPGxiVgNSAD2ADxhdSi5iY=VYYqYKErzYDx/GDUQKoQKYieonYFgYgmw3WDD; ssxmod_itna2=1-eqUx0DgQYiqxBDfxe947K7jneQuqiFeGHDyxWKG7DuZxjKidDRDB4ylDA7heG=Q2eBOGhhrqexD3rKe6jETIQNUd_NGlKeL3WUKeD",
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/home.html", "/api/*", "/company-option.html", "/knowledge-config.html", "/cdn-cgi/handler/scheduled"],
  },
  "routes": [
    {
      "pattern": "tinfo.cc",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "17 * * * *", "*/10 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock_info",
      "database_id": "6bbdca28-28da-42c2-9186-bb57f29bb7bc",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MARKET_DATA_BUCKET",
      "bucket_name": "stock-info-market-data",
    },
    {
      "binding": "KNOWLEDGE_CONTENT_BUCKET",
      "bucket_name": "stock-info-knowledge-content",
      "remote": true,
    },
  ],
}
