  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/home.html", "/api/*", "/company-option.html", "/knowledge-config.html", "/cdn-cgi/handler/scheduled"],
  },
  "routes": [
    {
      "pattern": "tinfo.cc",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "17 * * * *", "*/10 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock_info",
      "database_id": "6bbdca28-28da-42c2-9186-bb57f29bb7bc",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MARKET_DATA_BUCKET",
      "bucket_name": "stock-info-market-data",
    },
    {
      "binding": "KNOWLEDGE_CONTENT_BUCKET",
      "bucket_name": "stock-info-knowledge-content",
      "remote": true,
    },
  ],
}
