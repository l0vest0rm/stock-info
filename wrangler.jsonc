{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "MARKET_DATA_PUBLIC_BASE_URL": "https://market-data.tinfo.cc",
    "LLM_RUNTIME": "production",
