{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_RUNTIME": "cloudflare",
    "APP_VERSION": "0.1.0",
    "MARKET_DATA_PUBLIC_BASE_URL": "https://market-data.tinfo.cc",
    "LLM_RUNTIME": "production",
    "LLM_DAILY_LIMIT": "300",
    "HTTP_PROXY_URL": "",
    "HTTP_PROXY_DOMAINS": "",
    "HTTP_DOMAIN_CONCURRENCY": "5",
    "HTTP_REQUEST_TIMEOUT_MS": "10000",
    "KNOWLEDGE_CONTENT_PUBLIC_BASE_URL": "https://content.tinfo.cc",
    "KNOWLEDGE_ALLOW_TEXT_SEARCH": "false",
  },
  "ratelimits": [
    { "name": "AUTH_LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_RESET_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/*.html",
      "/api/*",
      "/cdn-cgi/handler/scheduled"
    ],
  },
  "routes": [
    {
      "pattern": "tinfo.cc",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "17 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock_info",
      "database_id": "6bbdca28-28da-42c2-9186-bb57f29bb7bc",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MARKET_DATA_BUCKET",
      "bucket_name": "stock-info-market-data",
    },
    {
      "binding": "KNOWLEDGE_CONTENT_BUCKET",
      "bucket_name": "stock-info-knowledge-content",
      "remote": true,
    },
  ],
}
