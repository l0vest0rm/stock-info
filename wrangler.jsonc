{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "MARKET_DATA_PUBLIC_BASE_URL": "https://market-data.tinfo.cc",
    "LLM_RUNTIME": "production",
    "LLM_DAILY_LIMIT": "300",
    "HTTP_PROXY_URL": "",
    "HTTP_PROXY_DOMAINS": "",
    "HTTP_DOMAIN_CONCURRENCY": "5",
    "HTTP_REQUEST_TIMEOUT_MS": "10000",
    "KNOWLEDGE_CONTENT_PUBLIC_BASE_URL": "https://content.tinfo.cc",
    "KNOWLEDGE_ALLOW_TEXT_SEARCH": "false",
    "XUEQIU_COOKIE": "acw_tc=3ccdc17d17862390450918649e5f1ddb7aa1c75e7f07a0af0a09b472c670dd; cookiesu=551786239046641; is_overseas=0; ssxmod_itna=1-QqfxRD9DyDBGiQG0zGCDIx3qiwrqKqGQiPDXDUqqiQGgDxFqAPqDHKIs7Dos8iQKADDK=e4fGRU1DBMxxbDnqD80DQeDvYxTqwGMFemiu5Q=ClxoUxa_YAS58nAI2wx3=70t/nLkueU8hWTibQGeD834NDYoDCqDS0DD99EdD4R3Dt4DIDAYDDxDWfeDBK=bQDGPNXCuN=eq5wYbNxi3Q7eeQDiU1xivadZWN=WqaxA3KHOWQlDGnjAOQD2TDj8ya8KGy7eGWW4ujuKGueUrNIoWb=PqUoWqMnGmUQGxbYGEx0h_BKDhB5ixXrqW7DGozN0sYG4dlttgQ1ghmDDioX39P=GibDU2atK1tnmp2YYpQA50qq0qPGGPmezBGsYe=m0x7XPSNP7GqWrqGm3S0ib4mDwYKexD; ssxmod_itna2=1-QqfxRD9DyDBGiQG0zGCDIx3qiwrqKqGQiPDXDUqqiQGgDxFqAPqDHKIs7Dos8iQKADDK=e4fGRtbDG_Wib=s4cEu5MSZTAKe85YckixD; u=551786239046641; xq_a_token=8726c7e17a6d858f8961ce2aa3ca13dfe5169baa; xq_id_token=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJ1aWQiOi0xLCJpc3MiOiJ1YyIsImV4cCI6MTc4ODgzMDc1OSwiY3RtIjoxNzg2MjM5MDE1ODI4LCJjaWQiOiJkOWQwbjRBWnVwIn0.J2t1t99JHWjDSpmODFTd5kcqH87EWICUUkNw6ZPbSLv6qJpO5NE_ffO6qJ_YAvrA83JtmeaOjwUa4dp-qb2MjBUCAu8SGFScmQkF2Rbc4N3bVIg0mhnXWRsPoyz_J-747LyW4QXPuiQz0FzpYVSmw3JW19la3V6J767h7YKPdrEVC9lwyb1XvxvumRYb4xpaV9KZbyX1VHlYbTqjZLIlBiytYdUTbaefVVTviIvBTow2W700Op6U5vC5WbkYEbAd7aNazOMJnQtTt_MKjEsa4LlA1Tva1GkUaSdZTgGR1hCA_9eWbl8M3ruCZr60xy_HiJiCWd5wa9-bSgouVEEGPQ; xq_r_token=45bc8eb6b2161a037aa8e31f1a6f6349b1518553; xqat=8726c7e17a6d858f8961ce2aa3ca13dfe5169baa",
