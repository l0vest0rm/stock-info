{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "MARKET_DATA_PUBLIC_BASE_URL": "https://market-data.tinfo.cc",
    "LLM_RUNTIME": "production",
    "LLM_DAILY_LIMIT": "300",
    "HTTP_PROXY_URL": "",
    "HTTP_PROXY_DOMAINS": "",
    "HTTP_DOMAIN_CONCURRENCY": "5",
    "HTTP_REQUEST_TIMEOUT_MS": "10000",
    "KNOWLEDGE_CONTENT_PUBLIC_BASE_URL": "https://content.tinfo.cc",
    "KNOWLEDGE_ALLOW_TEXT_SEARCH": "false",
    "XUEQIU_COOKIE": "acw_tc=276077e517861374740855591e7f4b7c6614cf6200bb319bb6a26ad225a189; cookiesu=301786137475170; is_overseas=0; ssxmod_itna=1-eq0EiKAIeIOG0KGCDIxYqW9D7qZDKqGKDXDUqqiQGgjDFqApqDH7mdjK5DUh7kGrHY1DOCYHtDl=Y2YDSxD6HDK4GTwzP_DD7R6rv9ed5AlGtoqK6adR=8HNYWAcK7Gl0xMBau96RBLpAXcBRYD8ShNDYoDCqDS0DD9RhdD4_3Dt4DIDAYDDxDWAeDBePbQDGpt6WTNdewKsDRtxi3QFQqDmqqCxi5aocntdQmWxAfParWQ/DGnAGOQjATDj8Ha7KGyFeGWiSbj2KGu4I2NmxnrdPw65gGijwe4o7meWRx4mitK9GeGGdeo0D0i4te_=Yxez5IGKU00rDDAKxHIBY4x5K2ye5gFmgbuaKuGiRGR2tt0tn2KlRr9rN/ri44VBb4iYVnh4Q4hm0YmYZtRdiwtVoNc_DD; ssxmod_itna2=1-eq0EiKAIeIOG0KGCDIxYqW9D7qZDKqGKDXDUqqiQGgjDFqApqDH7mdjK5DUh7kGrHY1DOCYyYDi=4DQw7SlOuIqR2u5ihh9eb8nA4D; u=301786137475170; xq_a_token=711478fcaffa49560b2873559a1332edd5de17e0; xq_id_token=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJ1aWQiOi0xLCJpc3MiOiJ1YyIsImV4cCI6MTc4NzUzNDY4NiwiY3RtIjoxNzg2MTM3NDQxMDQyLCJjaWQiOiJkOWQwbjRBWnVwIn0.Tr23MDJ_PBK6Q3abKstFbhkCygC3JlHOOTd9pKPtShy_lFrYZKzAkZupj9G7MgaJ_3iY3gRqiFdGc2kti_5ACOhsyPcBgx0SJaMBz8LYEWOpIciRE62O4oNRCx_xNbYnvQyVd_gDe9jg7wnAYxbGhkIVzbvUC6o-p57M-t9kexCG9hAwZE6aEqpFMZdd4iwalvAj27brLgjr14_75BmqDlRnwSejVmGtQIjzK5RdU-M8ZWOSOv6GLzszYn4W01rCqhHTkKiItxmyrATP2AFO46Zwc6eMMaFGz9pjQJu4Ipg6xOzrm5KDlj8aOo6xXg57_n3AFqKJU4Kj40KekKWscg; xq_r_token=b58118c6817cff5ce794f2fc4fd80f98d91c9ba0; xqat=711478fcaffa49560b2873559a1332edd5de17e0",
